---
import Layout from "@layouts/Layout.astro";
import Section from "@components/ui/layout/Section.astro";
import Container from "@components/ui/layout/Container.astro";
import Heading from "@components/ui/atoms/Heading.astro";
import Text from "@components/ui/atoms/Text.astro";
import Button from "@components/ui/atoms/Button.astro";

interface Props {
  title: string;
  description: string;
  eyebrow: string;
  heading: string;
  intro: string;
  ctaHeading?: string;
  ctaText?: string;
}

const {
  title,
  description,
  eyebrow,
  heading,
  intro,
  ctaHeading = "Talk to an advisor",
  ctaText = "Book a free consultation and we'll help you with your next steps.",
} = Astro.props;
---

<Layout title={title} description={description} navbarVariant="floating" footerVariant="nova" fullBleedTop>
  <Section tone="page" class="pt-32 pb-20 md:pt-40 md:pb-28">
    <Container class="max-w-3xl">
      <div class="mb-12" data-motion="fade">
        <Text variant="accent-label" class="mb-3">{eyebrow}</Text>
        <Heading tag="h1" variant="section-title" class="mb-4">{heading}</Heading>
        <Text variant="lead">{intro}</Text>
      </div>

      <div class="content-page grid gap-10 text-brand-dark/85">
        <slot />
      </div>

      <div class="mt-16 rounded-2xl bg-brand-dark p-8 text-center text-brand-light">
        <h2 class="mb-2 text-2xl font-semibold">{ctaHeading}</h2>
        <p class="mb-6 text-brand-light/80">{ctaText}</p>
        <Button href="/#contact" variant="accent">Book a free consultation</Button>
      </div>
    </Container>
  </Section>
</Layout>

<style>
  .content-page :global(h2) {
    margin-bottom: 0.75rem;
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--color-brand-dark);
  }
  .content-page :global(p + p) {
    margin-top: 0.75rem;
  }
  .content-page :global(ul) {
    display: grid;
    gap: 0.5rem;
    padding-left: 1.25rem;
    list-style: disc;
  }
  .content-page :global(a) {
    text-decoration: underline;
  }
</style>
