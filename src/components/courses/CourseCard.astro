---
import { coursePath, type Course } from "@utils/courses";

interface Props {
  course: Course;
}

const { course } = Astro.props;
const { title, subject, summary, duration, intakes } = course.data;
---

<a href={coursePath(course)} class="block h-full rounded-2xl border border-brand-dark/10 bg-white p-5 transition-shadow hover:shadow-lg">
  <span class="block text-xs font-semibold uppercase tracking-wide text-brand-dark/60">{subject}</span>
  <span class="mt-1 block text-lg font-semibold text-brand-dark">{title}</span>
  <span class="mt-2 block text-sm text-brand-dark/80">{summary}</span>
  <span class="mt-3 block text-sm text-brand-dark/60">{duration} · {intakes.join(", ")} start</span>
</a>
