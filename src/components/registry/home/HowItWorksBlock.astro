---
import Section from "@components/ui/layout/Section.astro";
import Container from "@components/ui/layout/Container.astro";
import Heading from "@components/ui/atoms/Heading.astro";
import Text from "@components/ui/atoms/Text.astro";

type Step = { title: string; description: string };
interface Props { title?: string; description?: string; steps?: Step[]; class?: string }

const { title, description, steps = [], class: className } = Astro.props as Props;
---

<Section id="how-it-works" tone="page" class:list={["py-16 md:py-24", className]}>
  <Container class="w-full max-w-none px-[clamp(1.5rem,5vw,5rem)]">
    <div class="mb-10 grid gap-4 md:mb-14 md:grid-cols-2 md:items-end">
      <Heading tag="h2" variant="section-title">{title}</Heading>
      <Text variant="lead">{description}</Text>
    </div>
    <ol class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {steps.map((step, index) => (
        <li class="flex h-full flex-col gap-3 rounded-[var(--rounded-lg)] border border-brand-dark/10 bg-white p-6">
          <span class="grid size-10 place-items-center rounded-full bg-brand-accent text-sm font-bold text-brand-dark">{index + 1}</span>
          <Heading tag="h3" variant="feature-title">{step.title}</Heading>
          <Text variant="body" class="text-brand-dark/75">{step.description}</Text>
        </li>
      ))}
    </ol>
  </Container>
</Section>
