---
import Layout from "@layouts/Layout.astro";
import Section from "@components/ui/layout/Section.astro";
import Container from "@components/ui/layout/Container.astro";
import Heading from "@components/ui/atoms/Heading.astro";
import Text from "@components/ui/atoms/Text.astro";
import LeadForm from "@components/leads/LeadForm";
---

<Layout
  title="Book a free consultation"
  description="Book a free consultation with an advisor to talk through courses, universities, applications and student finance."
  navbarVariant="floating"
  footerVariant="nova"
  fullBleedTop
>
  <Section tone="page" class="pt-32 pb-20 md:pt-40 md:pb-28">
    <Container class="max-w-2xl">
      <div class="mb-10 text-center" data-motion="fade">
        <Text variant="accent-label" class="mb-3">Free consultation</Text>
        <Heading tag="h1" variant="section-title" class="mb-4">Talk to an advisor</Heading>
        <Text variant="lead">Tell us a little about yourself and we'll get in touch to arrange a free consultation about your course, application and student finance.</Text>
      </div>
      <div class="rounded-3xl border border-brand-dark/10 bg-white p-6 shadow-xl shadow-brand-dark/5 sm:p-8">
        <LeadForm client:load source="book-page" />
      </div>
    </Container>
  </Section>
</Layout>
