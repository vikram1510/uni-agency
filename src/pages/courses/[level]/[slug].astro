---
import Layout from "@layouts/Layout.astro";
import Section from "@components/ui/layout/Section.astro";
import Container from "@components/ui/layout/Container.astro";
import Heading from "@components/ui/atoms/Heading.astro";
import Text from "@components/ui/atoms/Text.astro";
import Button from "@components/ui/atoms/Button.astro";
import { getEntries } from "astro:content";
import { getCourses, levelLabels, levelPath, type Course } from "@utils/courses";
import { universityPath } from "@utils/universities";

export async function getStaticPaths() {
  const courses = await getCourses();
  return courses.map((course) => ({
    params: { level: course.data.level, slug: course.id },
    props: { course },
  }));
}

const { course } = Astro.props as { course: Course };
const { title, level, summary, description, duration, intakes, entryRequirements, modules, careers } = course.data;
const universities = (await getEntries(course.data.universities)).sort((a, b) => a.data.name.localeCompare(b.data.name));
---

<Layout
  title={`${title} | ${levelLabels[level]} course`}
  description={summary}
  navbarVariant="floating"
  footerVariant="nova"
  fullBleedTop
>
  <Section tone="page" class="pt-32 pb-20 md:pt-40 md:pb-28">
    <Container class="max-w-4xl">
      <a href={levelPath(level)} class="mb-6 inline-block text-sm text-brand-dark/70 hover:text-brand-dark">← {levelLabels[level]} courses</a>

      <Text variant="accent-label" class="mb-3">{levelLabels[level]}</Text>
      <Heading tag="h1" variant="section-title" class="mb-4">{title}</Heading>
      <Text variant="lead" class="mb-10">{summary}</Text>

      <div class="grid gap-10 md:grid-cols-[1fr_18rem]">
        <div class="grid content-start gap-8 text-brand-dark/85">
          <div class="grid gap-4">
            {description.map((paragraph) => <p>{paragraph}</p>)}
          </div>

          <div>
            <h2 class="mb-3 text-xl font-semibold text-brand-dark">Entry requirements</h2>
            <ul class="grid list-disc gap-2 pl-5">
              {entryRequirements.map((item) => <li>{item}</li>)}
            </ul>
            <p class="mt-3 text-sm text-brand-dark/60">Requirements vary by university. We'll check what applies to you.</p>
          </div>

          {modules.length > 0 && (
            <div>
              <h2 class="mb-3 text-xl font-semibold text-brand-dark">What you'll study</h2>
              <ul class="grid list-disc gap-2 pl-5">
                {modules.map((item) => <li>{item}</li>)}
              </ul>
              <p class="mt-3 text-sm text-brand-dark/60">Typical modules. The exact content depends on the university.</p>
            </div>
          )}

          {careers.length > 0 && (
            <div>
              <h2 class="mb-3 text-xl font-semibold text-brand-dark">Where it can lead</h2>
              <ul class="flex flex-wrap gap-2">
                {careers.map((career) => (
                  <li class="rounded-full bg-brand-dark/5 px-3 py-1 text-sm text-brand-dark">{career}</li>
                ))}
              </ul>
            </div>
          )}
        </div>

        <aside class="grid content-start gap-6 rounded-2xl border border-brand-dark/10 bg-white p-6">
          <div>
            <h2 class="mb-1 text-sm font-semibold uppercase tracking-wide text-brand-dark/60">Duration</h2>
            <p class="text-brand-dark">{duration}</p>
          </div>
          <div>
            <h2 class="mb-1 text-sm font-semibold uppercase tracking-wide text-brand-dark/60">Start dates</h2>
            <p class="text-brand-dark">{intakes.join(", ")}</p>
          </div>
          <div>
            <h2 class="mb-2 text-sm font-semibold uppercase tracking-wide text-brand-dark/60">Universities</h2>
            {universities.length > 0 ? (
              <ul class="grid gap-1">
                {universities.map((uni) => (
                  <li><a href={universityPath(uni.id)} class="text-brand-dark underline">{uni.data.name}</a></li>
                ))}
              </ul>
            ) : (
              <p class="text-sm text-brand-dark/80">Offered at several universities. Ask us which ones fit you best.</p>
            )}
          </div>
        </aside>
      </div>

      <div class="mt-14 rounded-2xl bg-brand-dark p-8 text-center text-brand-light">
        <h2 class="mb-2 text-2xl font-semibold">Interested in {title}?</h2>
        <p class="mb-6 text-brand-light/80">Talk to an advisor about entry requirements, universities and student finance. It's free.</p>
        <Button href="/#contact" variant="accent">Book a free consultation</Button>
      </div>
    </Container>
  </Section>
</Layout>
