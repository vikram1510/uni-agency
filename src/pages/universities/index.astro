---
import Layout from "@layouts/Layout.astro";
import Section from "@components/ui/layout/Section.astro";
import Container from "@components/ui/layout/Container.astro";
import Heading from "@components/ui/atoms/Heading.astro";
import Text from "@components/ui/atoms/Text.astro";
import { getUniversities, universityPath } from "@utils/universities";

const universities = await getUniversities();
const groups = Object.entries(
  Object.groupBy(universities, (uni) => uni.data.name[0].toUpperCase()),
);
const letters = groups.map(([letter]) => letter);
---

<Layout
  title="Universities"
  description="Browse UK universities we work with and find the right one for you."
  navbarVariant="floating"
  footerVariant="nova"
  fullBleedTop
>
  <Section tone="page" class="pt-32 pb-20 md:pt-40 md:pb-28">
    <Container class="max-w-5xl">
      <div class="mb-10 text-center" data-motion="fade">
        <Text variant="accent-label" class="mb-3">Universities</Text>
        <Heading tag="h1" variant="section-title" class="mb-4">Find your university</Heading>
        <Text variant="lead">Browse the UK universities we work with, from A to Z.</Text>
      </div>

      <div class="mx-auto mb-8 max-w-xl">
        <label for="uni-search" class="sr-only">Search universities</label>
        <input
          id="uni-search"
          type="search"
          placeholder="Search by university name"
          autocomplete="off"
          class="w-full rounded-full border border-brand-dark/15 bg-white px-5 py-3 text-base text-brand-dark outline-none focus:border-brand-dark/40"
        />
      </div>

      <nav aria-label="Jump to letter" class="mb-10 flex flex-wrap justify-center gap-2">
        {letters.map((letter) => (
          <a
            href={`#letter-${letter}`}
            data-letter-link={letter}
            class="flex size-9 items-center justify-center rounded-full border border-brand-dark/15 text-sm font-semibold text-brand-dark hover:bg-brand-dark hover:text-brand-light"
          >
            {letter}
          </a>
        ))}
      </nav>

      <div class="grid gap-10">
        {groups.map(([letter, unis]) => (
          <section id={`letter-${letter}`} data-letter-group={letter}>
            <h2 class="mb-4 text-2xl font-semibold text-brand-dark">{letter}</h2>
            <ul class="grid gap-4 sm:grid-cols-2">
              {unis!.map((uni) => (
                <li data-uni-name={uni.data.name.toLowerCase()}>
                  <a
                    href={universityPath(uni.id)}
                    class="block h-full rounded-2xl border border-brand-dark/10 bg-white p-5 transition-shadow hover:shadow-lg"
                  >
                    <span class="block text-lg font-semibold text-brand-dark">{uni.data.name}</span>
                    <span class="mt-1 block text-sm text-brand-dark/60">{uni.data.locations.join(" · ")}</span>
                    <span class="mt-3 block text-sm text-brand-dark/80">{uni.data.summary}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>

      <p id="uni-empty" class="mt-10 text-center text-brand-dark/70" hidden>
        No universities match your search.
      </p>
    </Container>
  </Section>
</Layout>

<script>
  function setupSearch() {
    const input = document.querySelector<HTMLInputElement>("#uni-search");
    if (!input) return;
    const groups = document.querySelectorAll<HTMLElement>("[data-letter-group]");
    const empty = document.querySelector<HTMLElement>("#uni-empty");

    input.addEventListener("input", () => {
      const query = input.value.trim().toLowerCase();
      let visible = 0;
      groups.forEach((group) => {
        let groupVisible = 0;
        group.querySelectorAll<HTMLElement>("[data-uni-name]").forEach((item) => {
          const match = item.dataset.uniName!.includes(query);
          item.hidden = !match;
          if (match) groupVisible++;
        });
        group.hidden = groupVisible === 0;
        document
          .querySelector<HTMLElement>(`[data-letter-link="${group.dataset.letterGroup}"]`)
          ?.toggleAttribute("hidden", groupVisible === 0);
        visible += groupVisible;
      });
      if (empty) empty.hidden = visible > 0;
    });
  }

  document.addEventListener("astro:page-load", setupSearch);
</script>
