---
import Layout from "@layouts/Layout.astro";
import Section from "@components/ui/layout/Section.astro";
import Container from "@components/ui/layout/Container.astro";
import Heading from "@components/ui/atoms/Heading.astro";
import Text from "@components/ui/atoms/Text.astro";
import Button from "@components/ui/atoms/Button.astro";
import { getUniversities, levelLabels, type University } from "@utils/universities";

export async function getStaticPaths() {
  const universities = await getUniversities();
  return universities.map((uni) => ({ params: { slug: uni.id }, props: { uni } }));
}

const { uni } = Astro.props as { uni: University };
const { name, locations, summary, description, levels, subjects, website } = uni.data;
---

<Layout
  title={`${name} | Courses and how to apply`}
  description={summary}
  navbarVariant="floating"
  footerVariant="nova"
  fullBleedTop
>
  <Section tone="page" class="pt-32 pb-20 md:pt-40 md:pb-28">
    <Container class="max-w-4xl">
      <a href="/universities/" class="mb-6 inline-block text-sm text-brand-dark/70 hover:text-brand-dark">← All universities</a>

      <Text variant="accent-label" class="mb-3">{locations.join(" · ")}</Text>
      <Heading tag="h1" variant="section-title" class="mb-4">{name}</Heading>
      <Text variant="lead" class="mb-10">{summary}</Text>

      <div class="grid gap-10 md:grid-cols-[1fr_18rem]">
        <div class="grid gap-4 text-brand-dark/85">
          {description.map((paragraph) => <p>{paragraph}</p>)}
        </div>

        <aside class="grid content-start gap-6 rounded-2xl border border-brand-dark/10 bg-white p-6">
          <div>
            <h2 class="mb-2 text-sm font-semibold uppercase tracking-wide text-brand-dark/60">Study levels</h2>
            <ul class="grid gap-1 text-brand-dark">
              {levels.map((level) => <li>{levelLabels[level]}</li>)}
            </ul>
          </div>
          <div>
            <h2 class="mb-2 text-sm font-semibold uppercase tracking-wide text-brand-dark/60">Popular subjects</h2>
            <ul class="flex flex-wrap gap-2">
              {subjects.map((subject) => (
                <li class="rounded-full bg-brand-dark/5 px-3 py-1 text-sm text-brand-dark">{subject}</li>
              ))}
            </ul>
          </div>
          <a href={website} target="_blank" rel="noopener" class="text-sm text-brand-dark underline">Official website</a>
        </aside>
      </div>

      <div class="mt-14 rounded-2xl bg-brand-dark p-8 text-center text-brand-light">
        <h2 class="mb-2 text-2xl font-semibold">Thinking about {name}?</h2>
        <p class="mb-6 text-brand-light/80">Talk to an advisor about courses, entry requirements and student finance. It's free.</p>
        <Button href="/#contact" variant="accent">Book a free consultation</Button>
      </div>
    </Container>
  </Section>
</Layout>
