---
import { getLegalLayout } from "@/config/template-layouts";

const LegalLayout = await getLegalLayout();
import company from "@data/global/company.json";
import privacyContent from "@/content/legal/privacy-policy.json";
import { legalBodyToHtml } from "@utils/legal-body-to-html";

const injectData = (text: string) => {
  return text
    .replace(/{{COMPANY_NAME}}/g, company.name)
    .replace(/{{COMPANY_FULL_NAME}}/g, company.fullName)
    .replace(/{{COMPANY_EMAIL}}/g, company.email)
    .replace(/{{SITE_URL}}/g, company.siteUrl);
};

const html = legalBodyToHtml(injectData(privacyContent.body));
const title = privacyContent.title;
const description = injectData(privacyContent.description || "");
---

<LegalLayout 
  title={title} 
  description={description} 
  lastUpdated={privacyContent.lastUpdated}
>
  <div set:html={html} />
</LegalLayout>
