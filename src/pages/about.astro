import ContentPage from "@components/content/ContentPage.astro";
---

<ContentPage
  title="About us"
  description="UniPath helps UK students find the right university and course, apply with confidence and sort out student finance."
  eyebrow="About us"
  heading="Helping UK students find their way into university"
  intro="Choosing a university and course is a big decision. We make it simpler, with free, honest advice from people who know the system."
  ctaHeading="Ready to talk?"
  ctaText="Book a free consultation and tell us what you'd like to study. We'll take it from there."
>
  <section>
    <h2>Who we help</h2>
    <p>We work with students across the UK, whether you're finishing school or college, returning to study as an adult, or looking to complete a degree you started years ago.</p>
    <p>Many of the people we help don't have traditional qualifications. Access courses, foundation years, diplomas and top-up degrees all open doors, and we'll help you find the route that fits.</p>
  </section>

  <section>
    <h2>What we do</h2>
    <ul>
      <li>Help you choose a course and university that suit your interests, qualifications and life.</li>
      <li>Support your application, whether it's through UCAS or direct to the university.</li>
      <li>Help with your personal statement and getting your documents ready.</li>
      <li>Guide you through applying for student finance.</li>
      <li>Stay in touch through offers, interviews and enrolment.</li>
    </ul>
  </section>

  <section>
    <h2>How we work</h2>
    <p>We start by listening. In a free consultation we find out what you want to study, what you've done so far and what matters to you, such as location, start date and how you'd like to study.</p>
    <p>Then we suggest options that genuinely fit, explain the entry requirements and help you apply. You make the decisions. We make the process easier.</p>
  </section>

  <section>
    <h2>Our promise</h2>
    <ul>
      <li>Our advice is free for students.</li>
      <li>We're honest about your options, even if that means a different route.</li>
      <li>We keep your information safe. See our <a href="/privacy-policy/">privacy policy</a>.</li>
    </ul>
  </section>
</ContentPage>
